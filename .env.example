# Set this to local Ollama or a remote GPU server's Ollama API address.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set false when an external scheduler owns model residency.
CDM_RAG_MANAGE_MODEL_RESIDENCY=true

# Embedding uses the request timeout; chat uses the first-token and idle timeouts.
EMBEDDING_MODEL=qwen3-embedding:0.6b
ROUTER_MODEL=qwen3:4b
# Used by the separate local decision router; ROUTER_MODEL remains the query generator.
CDM_RAG_DECISION_MODEL=qwen3:4b
ANSWER_MODEL=qwen3:4b
SCOPE_MODEL=qwen3:4b
JUDGE_MODEL=qwen3:4b
CDM_RAG_JUDGE_ENABLED=false
# ollama: combined legacy planner; ollama-decision: separate local classifier;
# ollama-evidence: classify after a small hybrid pre-search; jev: hosted router.
CDM_RAG_ROUTER_BACKEND=ollama
CDM_RAG_RERANK_ENABLED=false
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_FIRST_TOKEN_TIMEOUT_SECONDS=300
OLLAMA_STREAM_IDLE_TIMEOUT_SECONDS=30
OLLAMA_QUERY_EMBEDDING_KEEP_ALIVE=0

# Maximum top-ranked retrieved passages passed to the generator (use 1 on low-memory machines).
CDM_RAG_GENERATION_PASSAGE_LIMIT=4

# Only list benchmark models whose local model file is below this size.
CDM_RAG_BENCHMARK_MODEL_MAX_GB=5
