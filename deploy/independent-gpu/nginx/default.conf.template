server {
    listen 127.0.0.1:${CDM_RAG_EDGE_PORT};
    server_name _;
    access_log off;
    client_max_body_size 2m;

    # Administrative endpoints are never public. Admin maintenance uses the
    # host loopback and a separate operator session.
    location = /identity/admin { return 404; }
    location ^~ /identity/admin/ { return 404; }
    location = /identity/realms/master { return 404; }
    location ^~ /identity/realms/master/ { return 404; }
    # The shared demo login must not expose Keycloak account self-service.
    # Demo users must also have the account-management roles removed; blocking
    # these paths alone does not prevent application-initiated OIDC actions.
    location = /identity/realms/cdm-rag/account { return 404; }
    location ^~ /identity/realms/cdm-rag/account/ { return 404; }
    # The proxy uses this OIDC flow for sign-in, not Keycloak's
    # application-initiated account actions. Forward only its known OAuth
    # parameters so encoded or duplicate kc_action parameters are dropped.
    location ^~ /identity/realms/cdm-rag/protocol/openid-connect/auth {
        if ($uri != /identity/realms/cdm-rag/protocol/openid-connect/auth) { return 404; }
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:19091/identity/realms/cdm-rag/protocol/openid-connect/auth?approval_prompt=$arg_approval_prompt&client_id=$arg_client_id&code_challenge=$arg_code_challenge&code_challenge_method=$arg_code_challenge_method&redirect_uri=$arg_redirect_uri&response_type=$arg_response_type&scope=$arg_scope&state=$arg_state&nonce=$arg_nonce&prompt=$arg_prompt;
        proxy_set_header Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /identity/ {
        proxy_pass http://127.0.0.1:19091;
        proxy_set_header Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    # Owner sessions may manage credentials. Application tokens cannot.
    location ^~ /api/v1/api-tokens {
        auth_request /_cdm_session_auth;
        auth_request_set $session_email $upstream_http_x_auth_request_email;
        auth_request_set $session_subject $upstream_http_x_auth_request_user;
        proxy_pass http://127.0.0.1:19093;
        proxy_set_header X-CDM-RAG-Owner-Session "${CDM_RAG_TRUSTED_PROXY_SECRET}";
        proxy_set_header X-CDM-RAG-Owner-Email $session_email;
        proxy_set_header X-CDM-RAG-Owner-Subject $session_subject;
        proxy_set_header Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 660s;
    }
    # Session requests must pass the login proxy's auth check. Bearer requests
    # go to the app's token verifier with any client-supplied session header removed.
    location ^~ /api/ {
        error_page 418 = @cdm_bearer;
        if ($http_authorization ~* "^Bearer[ ]") { return 418; }
        auth_request /_cdm_session_auth;
        auth_request_set $session_email $upstream_http_x_auth_request_email;
        auth_request_set $session_subject $upstream_http_x_auth_request_user;
        proxy_pass http://127.0.0.1:19093;
        proxy_set_header X-CDM-RAG-Owner-Session "${CDM_RAG_TRUSTED_PROXY_SECRET}";
        proxy_set_header X-CDM-RAG-Owner-Email $session_email;
        proxy_set_header X-CDM-RAG-Owner-Subject $session_subject;
        proxy_set_header Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
    location @cdm_bearer {
        proxy_pass http://127.0.0.1:19093;
        proxy_set_header X-CDM-RAG-Owner-Session "";
        proxy_set_header X-CDM-RAG-Owner-Email "";
        proxy_set_header X-CDM-RAG-Owner-Subject "";
        proxy_set_header Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
    location = /_cdm_session_auth {
        internal;
        proxy_pass http://127.0.0.1:19092/oauth2/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
    }
    # OAuth endpoints must reach the login proxy before a session exists.
    location ^~ /oauth2/ {
        proxy_pass http://127.0.0.1:19092;
        proxy_set_header Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
    location / {
        auth_request /_cdm_session_auth;
        error_page 401 = @cdm_login;
        auth_request_set $session_email $upstream_http_x_auth_request_email;
        auth_request_set $session_subject $upstream_http_x_auth_request_user;
        proxy_pass http://127.0.0.1:19093;
        proxy_set_header X-CDM-RAG-Owner-Session "${CDM_RAG_TRUSTED_PROXY_SECRET}";
        proxy_set_header X-CDM-RAG-Owner-Email $session_email;
        proxy_set_header X-CDM-RAG-Owner-Subject $session_subject;
        proxy_set_header Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 660s;
        proxy_buffering off;
    }
    location @cdm_login {
        proxy_pass http://127.0.0.1:19092;
        proxy_set_header Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${CDM_RAG_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
